# ============================================
# Wokker Bot — пример конфига окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения

# --- БАЗА ДАННЫХ (обязательно) ---
DATABASE_URL=postgresql://user:password@localhost:5432/postgres

# --- АДМИН (обязательно) ---
ADMIN_LOGIN=adm01
ADMIN_PASSWORD=your-secure-password-here

# --- VAPID (push-уведомления, опционально) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wokker.ru

# --- ОКОЛЕНИЕ ---
ENV=production
PORT=8080

# --- ДОВЕРЕННЫЕ ПРОКСИ ---
# CIDR через запятую. Прокси должен дописывать IP своего клиента справа в X-Forwarded-For.
TRUSTED_PROXY_CIDRS=

# --- ОГРАНИЧЕНИЯ ---
API_RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- СЕНТРИ (опционально) ---
SENTRY_DSN=
